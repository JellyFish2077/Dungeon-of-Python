{
  "name": "pydungeon",
  "private": true,
  "version": "1.11.0",
  "description": "PyDungeon — браузерная игра-подземелье с вопросами по Python",
  "scripts": {
    "dev": "vite",
    "dev:phaser": "vite --config vite.phaser.config.mjs",
    "build:editor": "vite build",
    "build:phaser": "vite build --config vite.phaser.config.mjs",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.game.json",
    "lint": "eslint tools/*.js *.js",
    "format:check": "prettier --check \"tools/village-editor/**/*.{html,css,ts,js}\" \"tools/phaser-prototype/**/*.{html,css,ts,js,mjs}\" \"*.{json,mjs}\"",
    "format": "prettier --write \"tools/village-editor/**/*.{html,css,ts,js}\" \"tools/phaser-prototype/**/*.{html,css,ts,js,mjs}\" \"*.{json,mjs}\"",
    "test:quick": "python run_all_checks.py --quick",
    "test": "python run_all_checks.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "phaser": "^4.2.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
