[Unit]
Description=PyDungeon class server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pyquiz
Group=pyquiz
WorkingDirectory=/opt/pyquiz
EnvironmentFile=/etc/pyquiz.env
ExecStart=/usr/bin/python3 /opt/pyquiz/server.py --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

# Каталог проекта только читается; данные класса — единственное место записи.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pyquiz
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
