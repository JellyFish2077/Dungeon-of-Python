# Скопируйте в /etc/pyquiz.env, замените PIN и права: root:pyquiz, 0640.
PYQUIZ_DATA_DIR=/var/lib/pyquiz
PYQUIZ_TEACHER_PIN=replace-with-long-teacher-pin
PYQUIZ_ADMIN_PIN=replace-with-another-long-pin

# На Linux это означает «только изоляция через unshare», а не процесс без
# песочницы. Если unshare недоступен, сервер откажется проверять код —
# это безопаснее, чем PYQUIZ_SANDBOX=process на публичном VPS.
PYQUIZ_SANDBOX=wsl
PYQUIZ_CODE_WORKERS=2

# Секрет можно не задавать: сервер создаст /var/lib/pyquiz/.secret сам.
# Если задаёте — храните его в тайне и не меняйте без перевыпуска токенов.
# PYQUIZ_SECRET=...
